# Kaggle API credentials (https://www.kaggle.com/settings)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Pipeline configuration
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
DUCKDB_PATH=data/olist.duckdb
LOG_LEVEL=INFO

# Cloud storage — "local" (MinIO via Docker) or "aws" (real S3)
CLOUD_PROVIDER=local

# MinIO local settings (used when CLOUD_PROVIDER=local)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# AWS settings (used when CLOUD_PROVIDER=aws)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# S3 bucket names
S3_RAW_BUCKET=olist-raw
S3_PROCESSED_BUCKET=olist-processed
